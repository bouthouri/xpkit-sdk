{
  "name": "@xpkit-dev/react-native",
  "version": "0.1.0",
  "description": "XP Kit for React Native: provider, hooks, MMKV storage adapter, achievement grid, onboarding carousel and what's-new modal.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bouthouri/xpkit-sdk.git",
    "directory": "packages/react-native"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xpkit-dev/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76",
    "react-native-mmkv": ">=3"
  },
  "peerDependenciesMeta": {
    "react-native-mmkv": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "~19.2.0",
    "jsdom": "^26.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
