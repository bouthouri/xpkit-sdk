{
  "name": "@xpkit-dev/core",
  "version": "0.1.0",
  "description": "XP Kit core engine: config schema, levels, streaks, milestones, achievements and persisted stores. Platform-free.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bouthouri/xpkit-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/bouthouri/xpkit-sdk/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/bouthouri/xpkit-sdk/issues"
  },
  "keywords": [
    "gamification",
    "achievements",
    "onboarding",
    "xp"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.7.0"
  }
}
