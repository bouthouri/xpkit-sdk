  "description": "XP Kit runtime — one platform-free brain (schema, stores, lifecycle, unlock evaluation) + thin per-platform renderers. Source-shipped, no build step.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./shared/index.ts",
  "exports": {
    ".": "./shared/index.ts",
    "./shared": "./shared/index.ts",
    "./onboarding": "./onboarding/index.ts",
    "./onboarding/native": "./onboarding/native/index.tsx",
    "./achievements": "./achievements/index.ts",
    "./achievements/native": "./achievements/native/index.tsx",
    "./fixtures/energy-xp.json": "./fixtures/energy-xp.json",
    "./fixtures/progres.json": "./fixtures/progres.json",
    "./fixtures/karv.json": "./fixtures/karv.json"
