      {
        "id": "progressCreated",
        "name": "Progress trackers created",
        "type": "counter",
        "description": "addProgres() — a new progress tracker is created."
      },
      {
        "id": "pathCreated",
        "name": "Paths created",
        "type": "counter",
        "description": "addPath() — a new path is added to a progress tracker."
      },
      {
        "id": "goalCreated",
        "name": "Goals created",
        "type": "counter",
        "description": "updatePath() — a path gains a .goal value."
      },
      {
        "id": "goalAchieved",
        "name": "Goals achieved",
        "type": "counter",
        "description": "A score crosses its .goal, or a number-path milestone is reached."
      },
      {
        "id": "progressAchieved",
        "name": "Progress trackers completed",
        "type": "counter",
        "description": "markStepAsDone() takes a progres to 100 percent."
      },
      {
        "id": "pathAchieved",
        "name": "Paths completed",
        "type": "counter",
        "description": "markStepAsDone() finishes the last step of a path."
      }
    ],
